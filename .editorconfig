root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml}]
indent_size = 2

[*.{ps1,bat,cs}]
end_of_line = crlf

[*.{py,md,json,yml,yaml}]
end_of_line = lf

# Windows PowerShell 5.1 also reads this file during setup.
[config.example.json]
charset = utf-8-bom
